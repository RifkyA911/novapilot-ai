# ==============================================================================
# NovaPilot AI — Enterprise Environment Configuration Template
# Copy this file to .env and adjust credentials to match your local setup.
# NEVER COMMIT THE ACTUAL .env FILE CONTAINING PRODUCTION SECRETS TO GIT!
# ==============================================================================

# Server & Network Configuration
APP_ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
WEBUI_PORT=3000

# Security, CORS & Authentication (Better Auth)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
INTERNAL_SECRET_TOKEN=novapilot-enterprise-secret-key-32chars
BETTER_AUTH_SECRET=novapilot-super-secret-key-internal-enterprise-32chars
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# ==============================================================================
# 1. DATABASE INTERNAL SISTEM (PostgreSQL / SQLite)
# Menyimpan data antrean tiket, log audit, pesan inbound chat, dan state sistem.
# ==============================================================================
SYSTEM_DB_DRIVER=postgres
SYSTEM_DB_HOST=localhost
SYSTEM_DB_PORT=5432
SYSTEM_DB_USER=postgres
SYSTEM_DB_PASSWORD=your_postgres_password
SYSTEM_DB_NAME=novapilot_system
SYSTEM_DB_SSLMODE=disable
SYSTEM_DB_MAX_OPEN_CONNS=25
SYSTEM_DB_MAX_IDLE_CONNS=10

# ==============================================================================
# 2. DATABASE REFERENSI MCP (Sumber Data Enterprise / Faktur / ERP)
# Sumber data yang diakses oleh Model Context Protocol (MCP) untuk validasi & mutasi faktur.
# ==============================================================================
MCP_REF_DB_DRIVER=postgres
MCP_REF_DB_HOST=localhost
MCP_REF_DB_PORT=5432
MCP_REF_DB_USER=postgres
MCP_REF_DB_PASSWORD=your_erp_password
MCP_REF_DB_NAME=novapilot_erp_reference
MCP_REF_DB_SSLMODE=disable
MCP_REF_DB_TIMEOUT_MS=5000

# Legacy fallback compatibility
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=novapilot_db
POSTGRES_SSLMODE=disable

# Oracle Database 11g Enterprise Adapter (Production On-Premises)
# Use TNS alias from your local tnsnames.ora or EZCONNECT string (host:port/service_name)
ORACLE_USER=app_it_support
ORACLE_PASSWORD=your_oracle_password_here
ORACLE_CONNECT_STRING=localhost:1521/XE
ORACLE_TNS_NAME=PROD_ERP
TNS_ADMIN=C:\oracle\instantclient_11_2\network\admin

# AI Model Configuration (Gemini API / Antigravity CLI / OpenAI Compatible)
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
AI_MODEL_NAME=gemini-1.5-flash

# ==============================================================================
# 3. HERMES 3 AGENTIC LLM CONFIGURATION (Ollama / Hermes Agent CLI)
# ==============================================================================
LLM_MODE=auto                                    # auto (HTTP -> CLI -> Heuristic), http, or cli
LLM_BASE_URL=http://localhost:11434/v1           # Ollama / vLLM OpenAI-compatible endpoint
LLM_MODEL=hermes3:8b                             # Model name in Ollama/vLLM
LLM_API_KEY=ollama                               # Optional API key

# Local Hermes Agent CLI (C:\Users\<user>\AppData\Local\hermes\bin\hermes.exe)
HERMES_CLI_PATH=C:\Users\rifky\AppData\Local\hermes\bin\hermes.exe
HERMES_CLI_PROVIDER=copilot                      # copilot, nous, etc.
HERMES_CLI_MODEL=gpt-4o

# WhatsApp ChatOps Gateway Service
WA_GATEWAY_URL=http://localhost:3002
WA_WHITELIST_GROUPS=120363041234567890@g.us,120363098765432100@g.us
WA_TEST_RECIPIENT=081228632195

