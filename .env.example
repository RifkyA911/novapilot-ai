# ==============================================================================
# NovaPilot AI — Enterprise Environment Configuration Template
# Copy this file to .env and adjust credentials to match your local setup.
# NEVER COMMIT THE ACTUAL .env FILE CONTAINING PRODUCTION SECRETS TO GIT!
# ==============================================================================

# Server & Network Configuration
APP_ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
WEBUI_PORT=3000

# Security, CORS & Authentication (Better Auth)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
INTERNAL_SECRET_TOKEN=novapilot-enterprise-secret-key-32chars
BETTER_AUTH_SECRET=novapilot-super-secret-key-internal-enterprise-32chars
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# PostgreSQL 18 Prototyping Database Configuration
# Default Windows port is 5432. If authentication fails, the backend automatically
# activates thread-safe in-memory cache fallback to prevent crashes.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_local_postgres_password
POSTGRES_DB=postgres
POSTGRES_SSLMODE=disable

# Oracle Database 11g Enterprise Adapter (Production On-Premises)
# Use TNS alias from your local tnsnames.ora or EZCONNECT string (host:port/service_name)
ORACLE_USER=app_it_support
ORACLE_PASSWORD=your_oracle_password_here
ORACLE_CONNECT_STRING=localhost:1521/XE
ORACLE_TNS_NAME=PROD_ERP
TNS_ADMIN=C:\oracle\instantclient_11_2\network\admin

# AI Model Configuration (Gemini API / Antigravity CLI / OpenAI Compatible)
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
AI_MODEL_NAME=gemini-1.5-flash

# WhatsApp ChatOps Gateway Service
WA_GATEWAY_URL=http://localhost:3001
WA_WHITELIST_GROUPS=120363041234567890@g.us,120363098765432100@g.us
