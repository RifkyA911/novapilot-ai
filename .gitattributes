# Auto detect text files and perform LF normalization
* text=auto

# Source code files
*.go text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.svelte text eol=lf
*.json text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.css text eol=lf
*.html text eol=lf

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Windows batch & powershell
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.db binary
*.sqlite binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
