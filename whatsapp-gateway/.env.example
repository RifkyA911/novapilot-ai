# ==============================================================================
# NovaPilot AI - WhatsApp Gateway Configuration Template
# Copy to .env and configure with your internal group IDs
# ==============================================================================

# Core NovaPilot Golang Backend Ingestion URL
NOVAPILOT_BACKEND_URL=http://127.0.0.1:8088

# Whitelisted WhatsApp Group JIDs (comma-separated)
# Messages from outside these groups are strictly discarded to prevent spam
WHITELISTED_GROUPS=120363028472918293@g.us,120363098273645129@g.us

# Branch ID Mappings (Group JID to Factory Branch ID in NovaPilot DB)
# Format: JID=BRANCH_ID
BRANCH_MAP_120363028472918293@g.us=1
BRANCH_MAP_120363098273645129@g.us=2

# Bot Notification Settings
AUTO_REPLY_ENABLED=true
BOT_PREFIX=[NovaPilot AI]

# Offline Simulation Mode (Set to true to test without physical phone)
SIMULATION_MODE=false
